# ----------------------------------------------------
# Konfigurasi Apache / LiteSpeed untuk Rekam Medis
# ----------------------------------------------------

# Cegah pengunjung melihat daftar isi folder (Directory Listing)
Options -Indexes

# Lindungi file database dan konfigurasi sensitif agar tidak bisa di-download publik
<FilesMatch "\.(sql|log|ini|env|sh|bak|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Set default charset UTF-8
AddDefaultCharset UTF-8

# Pengaturan upload PHP jika didukung hosting
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
